 /* CX HACK 23950 - END */
+
+/* Cross-process painting: a DC whose top-level window belongs to another process (for
+ * instance Chromium's GPU/compositor process painting into the browser's window) gets a
+ * shared memory surface that is flushed to the window's owner, which copies it onto its
+ * own window surface. Without this the drawing is silently discarded. */
+static struct
+{
+    HWND hwnd;
+    struct window_surface *surface;
+} xproc_surfaces[16];
+static pthread_mutex_t xproc_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static struct window_surface *get_cross_process_surface( HWND top_win, const RECT *top_rect )
+{
+    struct window_surface *surface, *old = NULL;
+    int i, slot = -1;
+
+    pthread_mutex_lock( &xproc_lock );
+    for (i = 0; i < ARRAY_SIZE(xproc_surfaces); i++)
+    {
+        if (xproc_surfaces[i].hwnd == top_win) { slot = i; break; }
+        if (slot < 0 && !xproc_surfaces[i].hwnd) slot = i;
+    }
+    if (slot < 0) slot = 0;
+    if (xproc_surfaces[slot].hwnd == top_win) old = xproc_surfaces[slot].surface;
+
+    surface = create_shm_surface( top_win, top_win, top_rect, old );
+    if (surface && surface == old)
+    {
+        /* reused: create_shm_surface added the caller's reference */
+    }
+    else
+    {
+        struct window_surface *prev = xproc_surfaces[slot].surface;
+        register_window_surface( prev, surface );
+        if (prev) window_surface_release( prev );
+        xproc_surfaces[slot].hwnd = surface ? top_win : 0;
+        xproc_surfaces[slot].surface = surface;
+        if (surface) window_surface_add_ref( surface ); /* caller's reference */
+        TRACE( "cross-process surface %p for %p %s\n", surface, top_win, wine_dbgstr_rect( top_rect ) );
+    }
+    pthread_mutex_unlock( &xproc_lock );
+    return surface;
+}
 
 
